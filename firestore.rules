rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contact Form Submissions - General inquiries
    match /contacts/{document} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Emergency Service Requests - Urgent HVAC issues
    match /emergency_requests/{document} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Service Requests - Scheduled HVAC services
    match /service_requests/{document} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Customer Information - For existing customers
    match /customers/{document} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
